<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- 仅依赖 GUI 契约项目，不引用业务模块内部实现 -->
    <ProjectReference Include="..\EonVientiane.GUI\EonVientiane.GUI.csproj" />
  </ItemGroup>

  <!-- 构建成功后，将本模块 DLL 复制到工作区 gui-modules/ 目录，GUI 启动时自动扫描加载 -->
  <Target Name="CopyToGuiModules" AfterTargets="Build">
    <PropertyGroup>
      <GuiModulesDir>$(MSBuildThisFileDirectory)..\gui-modules\</GuiModulesDir>
    </PropertyGroup>
    <MakeDir Directories="$(GuiModulesDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(GuiModulesDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
