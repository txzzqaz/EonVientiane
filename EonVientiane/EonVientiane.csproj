<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 根据平台条件设置 OutputType -->
    <OutputType Condition="'$(TargetRID)' == 'win-x64' or '$(TargetRID)' == '' or '$(TargetRID)' == 'win'">WinExe</OutputType>
    <OutputType Condition="'$(TargetRID)' == 'osx-x64' or '$(TargetRID)' == 'osx-arm64'">Exe</OutputType>
    <OutputType Condition="'$(TargetRID)' == 'linux-x64'">Exe</OutputType>
    
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    
    <!-- 移动端支持配置 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 平台特定的属性 -->
  <PropertyGroup Condition="'$(TargetRID)' == 'ios' or '$(TargetRID)' == 'iossimulator'">
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetRID)' == 'android'">
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/Shared.csproj" />
  </ItemGroup>
</Project>
